# Copy this file to .env and fill in your real key.
#   cp .env.example .env
#
# .env is in .gitignore — do NOT commit a real key.

# Get a key at https://console.groq.com
# Used for: issue splitting, LLM fallback routing, bootstrap classification.
GROQ_API_KEY=your_groq_api_key_here

# Optional. Embeddings and the cross-encoder run locally through fastembed,
# so no API key is needed. On the first run fastembed downloads ~150 MB of
# ONNX weights into <system temp>/fastembed_cache. Set this to a writable
# directory to put the cache somewhere else (useful on read-only hosts).
# FASTEMBED_CACHE_PATH=C:\fastembed
